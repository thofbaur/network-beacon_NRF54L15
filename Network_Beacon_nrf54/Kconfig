mainmenu "DSA Network Beacon"

source "Kconfig.zephyr"

menu "DSA development options"

config DSA_DEV_VALIDATION
	bool
	default y if DSA_DEV_SYNTHETIC_CONTACTS
	default y if DSA_DEV_SYNTHETIC_SELF_REPORTS

config DSA_DEV_SYNTHETIC_CONTACTS
	bool "Insert synthetic contacts at startup"
	default n
	help
	  Build the development contact generator and insert synthetic contacts
	  at startup. Keep this disabled for production firmware.

config DSA_DEV_SYNTHETIC_CONTACT_COUNT
	int "Synthetic contacts inserted at startup"
	default 100
	range 0 65535
	help
	  Number of synthetic contacts inserted at startup when development
	  contact generation is enabled. Ignored when synthetic contacts are
	  disabled.

config DSA_DEV_SYNTHETIC_SELF_REPORTS
	bool "Insert synthetic self reports at startup"
	default n
	help
	  Build the development self-report generator and insert synthetic
	  self reports at startup. Keep this disabled for production firmware.

config DSA_DEV_SYNTHETIC_SELF_REPORT_COUNT
	int "Synthetic self reports inserted at startup"
	default 0
	range 0 65535
	help
	  Number of synthetic self reports inserted at startup when development
	  self-report generation is enabled. Ignored when synthetic self reports
	  are disabled.

config DSA_DEV_ECO_LED_INDICATOR
	bool "Light a solid LED during energy conservation mode"
	default n
	help
	  Keep an LED lit instead of off while inactivity detection has put
	  the device into energy conservation mode, so the mode is visible
	  during development. This works against the point of energy
	  conservation by keeping an LED powered. Keep this disabled for
	  production firmware.

endmenu

menu "DSA LED behavior"

config DSA_DEFAULT_LED_ACTIVE
	bool "Enable status LED blinking by default"
	default n

config DSA_LED_BLINK_INTERVAL_MS
	int "Default status LED blink interval in milliseconds"
	default 20000
	range 1000 65535000

config DSA_LED_BLINK_ON_MS
	int "Status LED on-time in milliseconds"
	default 30
	range 1 60000

config DSA_SELF_REPORT_LED_ON_MS
	int "Self-report LED on-time in milliseconds"
	default 2000
	range 1 60000

endmenu

menu "DSA network buffering"

config DSA_NETWORK_RING_COUNT
	int "Contact entries held in RAM"
	default 24000
	range 1 65535

config DSA_NETWORK_DEFAULT_RSSI_THRESHOLD
	int "Default RSSI magnitude threshold"
	default 80
	range 0 255

config DSA_NETWORK_DEFAULT_RSSI_THRESHOLD_LOCATION
	int "Default RSSI magnitude threshold for DSL location tags"
	default 100
	range 0 255
	help
	  Location tags (advertised name "DSL") are stationary and use a
	  separate, looser threshold than moving person-worn beacons (DSA/
	  DST), since interaction distance for a fixed location doesn't need
	  the same precision. Magnitude only: 100 means -100 dBm.

config DSA_NETWORK_DEFAULT_TRACKING_ACTIVE
	bool "Enable contact tracking by default"
	default y

config DSA_NETWORK_STATUS_UPDATE_DELAY_MS
	int "Contact status update delay in milliseconds"
	default 300
	range 0 60000

config DSA_NETWORK_FLUSH_THRESHOLD
	int "RAM contact count that starts flash flushing"
	default 23700
	range 1 65535

config DSA_NETWORK_FLASH_SIZE_BYTES
	hex "Contact flash partition size in bytes"
	default 0xf1000
	help
	  Must match contact_storage's size in pm_static.yml. Bounded by
	  nRF54L15's real usable flash (0x165000, after FLPR and TF-M's NS
	  storage reservations) minus the fixed 2-sector NVS minimum each for
	  self_report_storage, settings_storage, and eco_log_storage, minus
	  the tfm/app firmware image partitions (each right-sized to actual
	  usage plus ~25 kB growth headroom - see pm_static.yml).

endmenu

menu "DSA battery monitoring"

config DSA_BATTERY_MEASURE_INTERVAL_MS
	int "Battery voltage measurement interval in milliseconds"
	default 14400000
	range 1000 86400000
	help
	  Delay between periodic battery voltage measurements. The default is
	  four hours.

endmenu

menu "DSA radio timing"

config DSA_ADV_INTERVAL_MIN_MS
	int "High-activity minimum advertising interval in milliseconds"
	default 90
	range 20 10240

config DSA_ADV_INTERVAL_MAX_MS
	int "High-activity maximum advertising interval in milliseconds"
	default 120
	range 20 10240

config DSA_SCAN_WINDOW_MS
	int "High-activity scan window in milliseconds"
	default 120
	range 3 10240

config DSA_SCAN_INTERVAL_MS
	int "High-activity scan interval in milliseconds"
	default 7000
	range 3 10240

config DSA_ECO_ADV_INTERVAL_MIN_MS
	int "Energy-conservation minimum advertising interval in milliseconds"
	default 90
	range 20 10240
	help
	  Advertising is not reduced in energy conservation mode by default;
	  this matches the high-activity interval but can be changed
	  independently later.

config DSA_ECO_ADV_INTERVAL_MAX_MS
	int "Energy-conservation maximum advertising interval in milliseconds"
	default 120
	range 20 10240

config DSA_ECO_SCAN_WINDOW_MS
	int "Energy-conservation scan burst duration in milliseconds"
	default 100
	range 3 10240
	help
	  How long each periodic scan burst listens for, while inactivity
	  detection has the device in energy conservation mode.

config DSA_RADIO_DEFAULT_HIGH_ACTIVITY
	bool "Start in high-activity radio mode by default"
	default y

config DSA_ECO_SCAN_INTERVAL_MS
	int "Energy-conservation scan burst period in milliseconds"
	default 300000
	range 1000 3600000
	help
	  Period between scan bursts while inactivity detection has the
	  device in energy conservation mode. Advertising keeps its own
	  (usually normal-rate) interval in this mode; only scanning is
	  duty-cycled. This value exceeds what the BLE scan-interval field
	  can express (max ~10.24 s), so it is implemented as periodic
	  application-triggered scan bursts (each DSA_ECO_SCAN_WINDOW_MS
	  long) rather than a single scan parameter.

endmenu

menu "DSA NUS transport"

config DSA_NUS_IDLE_TIMEOUT_MS
	int "NUS connection idle timeout in milliseconds"
	default 5000
	range 1000 600000

endmenu

menu "DSA inactivity detection"

config DSA_MOTION_DEFAULT_ACTIVE
	bool "Enable inactivity-based energy conservation by default"
	default y

config DSA_MOTION_INACTIVITY_TIMEOUT_S
	int "Default inactivity timeout before energy conservation mode, in seconds"
	default 3600
	range 1 65535

endmenu

menu "DSA eco log storage"

config DSA_ECO_LOG_RING_COUNT
	int "Eco session entries held in RAM"
	default 64
	range 1 65535

config DSA_ECO_LOG_FLUSH_THRESHOLD
	int "Eco log RAM flush threshold"
	default 63
	range 2 65535
	help
	  Start moving the oldest eco sessions to flash when this many
	  sessions are buffered in RAM.

config DSA_ECO_LOG_FLASH_SIZE_BYTES
	hex "Eco log flash partition size in bytes"
	default 0x2000
	help
	  Size of the fixed flash partition reserved for the eco log. The
	  partition must contain at least two complete flash sectors.

config DSA_ECO_LOG_FLUSH_BATCH
	int "Eco sessions written per flash block"
	default 16
	range 1 64

config DSA_ECO_LOG_FLUSH_RETRY_MS
	int "Eco log flash retry delay in milliseconds"
	default 5000
	range 100 60000
	help
	  Delay before retrying a failed eco log flash write.

endmenu

menu "DSA self-report storage"

config DSA_SELF_REPORT_LONG_PRESS_MS
	int "Button hold time required for a self report"
	default 3000
	range 100 60000

config DSA_SELF_REPORT_RING_COUNT
	int "Self-report entries held in RAM"
	default 256
	range 1 65535

config DSA_SELF_REPORT_FLUSH_THRESHOLD
	int "Self-report RAM flush threshold"
	default 254
	range 2 65535
	help
	  Start moving the oldest reports to flash when this many reports
	  are buffered in RAM.

config DSA_SELF_REPORT_FLASH_SIZE_BYTES
	hex "Self-report flash partition size in bytes"
	default 0x2000
	help
	  Size of the fixed flash partition reserved for self reports. The
	  partition must contain at least two complete flash sectors.

config DSA_SELF_REPORT_FLUSH_BATCH
	int "Reports written per flash block"
	default 64
	range 1 64
	help
	  Number of oldest RAM reports reserved for each flash write.

config DSA_SELF_REPORT_FLUSH_RETRY_MS
	int "Self-report flash retry delay in milliseconds"
	default 5000
	range 100 60000
	help
	  Delay before retrying a failed self-report flash write.

endmenu
